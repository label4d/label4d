+		static size_t virtualUsedMax = 0;
+		static size_t physicalUsedMax = 0;
+
+		virtualUsedMax = max(virtualMemUsedByMe, virtualUsedMax);
+		physicalUsedMax = max(physMemUsedByMe, physicalUsedMax);

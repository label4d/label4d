+inline string stringReplace(string str, string search, string replacement) {
+
+	auto index = str.find(search);
+
+	if (index == str.npos) {
+		return str;
+	}
+
+	string strCopy = str;
+	strCopy.replace(index, search.length(), replacement);
+
+	return strCopy;
+}
